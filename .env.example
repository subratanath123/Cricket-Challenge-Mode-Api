# Copy this file to `.env` next to docker-compose.yml and fill in real values.
# Docker Compose reads `.env` from the same directory automatically.

# Docker Hub (used to pull the pre-built API image)
DOCKERHUB_USERNAME=subratanath123
DOCKERHUB_TOKEN=your-dockerhub-access-token
DOCKERHUB_IMAGE=howzat-api
IMAGE_TAG=latest

# API
API_PORT=8080

# MongoDB Atlas
# Database Access user + Network Access must allow this machine's IP (or 0.0.0.0/0).
# URL-encode special characters in the password (@, :, /, %, #, $).
# If the password contains $, write $$ in this file so Compose does not interpolate it.
SPRING_DATA_MONGODB_DATABASE=howzat
SPRING_DATA_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/howzat?retryWrites=true&w=majority
